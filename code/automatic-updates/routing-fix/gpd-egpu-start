#!/usr/bin/python3
"""Dispatch every approved kernel through the complete compute/display loader."""
import hashlib
import os
from pathlib import Path
import runpy
import sys
sys.dont_write_bytecode = True
READER = '/opt/gpd-egpu/update-support/registry.py'
DISPLAY = '/opt/gpd-egpu/display-extension/display-start.py'
def select(kernel, records):
    if kernel not in records:
        raise RuntimeError('No approved eGPU build for kernel '+kernel)
    return DISPLAY

def main():
    if os.geteuid() != 0 or sys.argv[1:]:
        raise SystemExit('Run with sudo, no arguments')
    if hashlib.sha256(Path(READER).read_bytes()).hexdigest() != '524499d9ee094d98023cdd63d1461dc1ea0989612be929d9f458869d647125b3':
        raise RuntimeError('Registry reader changed')
    records = runpy.run_path(READER)['read']()
    target = select(os.uname().release, records)
    if hashlib.sha256(Path(target).read_bytes()).hexdigest() != '12158c548aa238800c0f8411816473ef7bb4969141f5b4292a4afc9a786899db':
        raise RuntimeError('Display loader changed')
    os.execv('/usr/bin/python3', ['/usr/bin/python3', target])
if __name__ == '__main__': main()
